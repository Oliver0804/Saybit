{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "saybit-desktop",
  "version": "0.2.2",
  "identifier": "com.oliver.saybit-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Saybit Settings",
        "width": 900,
        "height": 650,
        "decorations": true,
        "transparent": true,
        "resizable": true,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Saybit Capsule",
        "width": 420,
        "height": 90,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "global-shortcut": {},
    "clipboard-manager": {},
    "store": {}
  }
}
